# Copy to .env and fill in. docker compose reads .env automatically.
# Wrap values in single quotes so characters like $ & ! are taken literally.

# Postgres. Changing these after the first start has no effect on an existing
# database volume; Postgres only reads them when it creates the volume.
POSTGRES_USER=minusone
POSTGRES_PASSWORD=''
POSTGRES_DB=minusone

# RustFS (S3). The access key is the username, the secret key the password.
S3_ACCESS_KEY=minusone
S3_SECRET_KEY=''
S3_BUCKET=minusone

# App
MINUSONE_PORT=8080          # port on the host
MINUSONE_REGISTRATION=open  # open | closed

# Running the app outside docker (go run .) uses MINUSONE_* directly instead:
# MINUSONE_ADDR, MINUSONE_REGISTRATION,
# MINUSONE_DB_HOST, MINUSONE_DB_PORT, MINUSONE_DB_USER, MINUSONE_DB_PASSWORD, MINUSONE_DB_NAME, MINUSONE_DB_SSLMODE,
# MINUSONE_S3_ENDPOINT, MINUSONE_S3_ACCESS_KEY, MINUSONE_S3_SECRET_KEY, MINUSONE_S3_BUCKET, MINUSONE_S3_SSL
# Their defaults match this setup with the passwords "minusone" / "minusone-secret".
